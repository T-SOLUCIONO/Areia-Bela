{
  "name": "areia-bela",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@areia-bela/web",
    "build": "turbo run build",
    "start": "pnpm --filter @areia-bela/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "5.7.3"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored --config apps/web/eslint.config.mjs"
    ],
    "apps/api/**/*.ts": [
      "eslint --fix --no-warn-ignored --config apps/api/eslint.config.mjs"
    ],
    "**/*.{ts,tsx,js,jsx,json,md,mdx,css}": [
      "prettier --write"
    ]
  }
}
