// Areia Bela — whole-home rental (1 Property). See docs/domain-decisions.md.
// Scope note: no CMSPage/SiteSettings/Gallery/FAQ (Fase 5 CMS) tables yet —
// that phase hasn't started. User/RefreshToken landed in Fase 4 (auth).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id                         String   @id @default(cuid())
  slug                       String   @unique
  nameEs                     String
  nameEn                     String
  descriptionEs              String
  descriptionEn              String
  maxGuests                  Int
  additionalGuestFeePerNight Decimal  @db.Decimal(10, 2)
  cleaningFee                Decimal  @db.Decimal(10, 2)
  serviceFeePercent          Decimal  @db.Decimal(5, 2)
  taxesPercent               Decimal  @db.Decimal(5, 2)
  bedrooms                   Int
  bathrooms                  Int
  amenities                  String[]
  address                    String
  city                       String
  state                      String
  country                    String
  checkInTime                String
  checkOutTime               String
  trashCollectionDays        String[]
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  bookings     Booking[]
  extras       Extra[]
  priceRules   PriceRule[]
  blockedDates BlockedDate[]
}

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  country   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

model Booking {
  id              String        @id @default(cuid())
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  checkIn         DateTime      @db.Date
  checkOut        DateTime      @db.Date
  adults          Int
  children        Int
  infants         Int
  status          BookingStatus @default(PENDING)
  totalPrice      Decimal       @db.Decimal(10, 2)
  specialRequests String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  extras BookingExtra[]

  @@index([propertyId, checkIn, checkOut])
}

enum ExtraPricingType {
  PER_NIGHT
  PER_HOUR
  PER_STAY
}

model Extra {
  id                  String           @id @default(cuid())
  propertyId          String
  property            Property         @relation(fields: [propertyId], references: [id])
  key                 String
  nameEs              String
  nameEn              String
  pricingType         ExtraPricingType
  price               Decimal          @db.Decimal(10, 2)
  refundable          Boolean          @default(true)
  seasonStartMonthDay String? // "MM-DD", e.g. heated pool season start
  seasonEndMonthDay   String?
  requiresRequest     Boolean          @default(false)
  active              Boolean          @default(true)

  bookingExtras BookingExtra[]

  @@unique([propertyId, key])
}

model BookingExtra {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraId   String
  extra     Extra   @relation(fields: [extraId], references: [id])
  quantity  Int     @default(1)

  @@unique([bookingId, extraId])
}

enum SeasonType {
  LOW
  HIGH
  WEEKEND
}

model PriceRule {
  id          String     @id @default(cuid())
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id])
  name        String
  type        SeasonType
  startDate   DateTime?  @db.Date // null for the recurring WEEKEND rule
  endDate     DateTime?  @db.Date
  nightlyRate Decimal    @db.Decimal(10, 2)
  active      Boolean    @default(true)
}

model BlockedDate {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?

  @@index([propertyId, startDate, endDate])
}

// Fase 4 (auth). Staff accounts for /admin — distinct from Customer, which is
// a booking guest and never signs in. Roles are a fixed enum rather than
// Role/Permission tables: docs/domain-decisions.md pins them to these three.
enum UserRole {
  SUPERADMIN
  MANAGER
  VIEWER
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? // set by the brute-force lockout, cleared on success
  lastLoginAt         DateTime?
  // TOTP second factor. The secret is encrypted at rest (AES-256-GCM, key from
  // TOTP_ENCRYPTION_KEY) because unlike a password hash it must be recoverable
  // to verify codes — storing it in plaintext would make a DB leak enough to
  // mint valid codes. totpEnabledAt is null until the user confirms setup.
  totpSecret          String?
  totpEnabledAt       DateTime?
  // Invitation state. passwordHash is filled with an unguessable random value
  // when someone is invited, so the account exists but cannot be signed into
  // until they follow the emailed link. passwordSetAt is what distinguishes
  // "invited, never signed in" from "active" — keeping passwordHash non-null
  // avoids null-guarding argon2.verify in four call sites.
  invitedAt           DateTime?
  passwordSetAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  recoveryCodes       RecoveryCode[]
  passwordResetTokens PasswordResetToken[]
}

// Refresh tokens are opaque (not JWTs) and stored hashed, so a database leak
// can't be replayed. Rotated on every use: the previous row is revoked.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use fallback codes so losing the authenticator device doesn't mean
// losing the account. Hashed, like refresh tokens — the plaintext is shown to
// the user exactly once, at setup.
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String    @unique
  usedAt   DateTime?

  @@index([userId])
}

// Emailed password-reset links. Hashed and single-use like the tokens above,
// and short-lived: the link travels through email, which we don't control.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
