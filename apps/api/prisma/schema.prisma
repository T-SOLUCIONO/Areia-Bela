// Areia Bela — whole-home rental (1 Property). See docs/domain-decisions.md.
// User/RefreshToken landed in Fase 4 (auth); CMSPage/SiteSettings/GalleryImage/
// FAQ in Fase 5 (CMS); Refund in Fase 7 (money leaving needs a ledger, not a
// column — see docs/changelog.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id                         String             @id @default(cuid())
  slug                       String             @unique
  name                       String
  description                String
  maxGuests                  Int
  additionalGuestFeePerNight Decimal            @db.Decimal(10, 2)
  cleaningFee                Decimal            @db.Decimal(10, 2)
  // Taken off the nights once a stay is long enough. Editable, because it is
  // a commercial lever the host pulls, not a constant of the house.
  weeklyDiscountPercent      Decimal            @default(10) @db.Decimal(5, 2)
  weeklyDiscountNights       Int                @default(7)
  // Commercial levers, like the discount above: the real listing allows a
  // single night and up to a year, but the host changes these by season.
  minNights                  Int                @default(1)
  maxNights                  Int                @default(365)
  // MODERATE matches what the site has been telling guests all along —
  // "free cancellation until 5 days before" — so it is the only default that
  // does not contradict a promise already made. Editable from the panel.
  cancellationPolicy         CancellationPolicy @default(MODERATE)
  // Anything every guest needs and nobody thinks to ask: where to park, how
  // the door works. Empty until the host writes it; nothing here is invented.
  accessNotes                String?
  serviceFeePercent          Decimal            @db.Decimal(5, 2)
  taxesPercent               Decimal            @db.Decimal(5, 2)
  bedrooms                   Int
  bathrooms                  Int
  amenities                  String[]
  address                    String
  city                       String
  state                      String
  country                    String
  checkInTime                String
  checkOutTime               String
  trashCollectionDays        String[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  bookings     Booking[]
  extras       Extra[]
  priceRules   PriceRule[]
  blockedDates BlockedDate[]
}

model Customer {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String   @unique
  phone            String
  country          String
  notes            String?
  /// The one Stripe customer this guest owns, created the first time they pay
  /// and reused for ever after.
  ///
  /// Without it Stripe fragments a person across records: `customer_email`
  /// attaches a payment to nobody, and `customer_creation: 'always'` mints a
  /// fresh customer per checkout, since Stripe never deduplicates by email.
  /// One guest with three stays became three entities plus a Dashboard-only
  /// "guest" grouping. Owning the key here is what keeps them one person.
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings    Booking[]
  loginTokens GuestLoginToken[]
}

enum BookingSource {
  WEBSITE
  PANEL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

// Emailed sign-in links for the guest area. Same shape as PasswordResetToken —
// hashed, single-use, short-lived — because it is the same problem: a secret
// travelling through email, a channel we do not control.
//
// New entity, justified: guests authenticate against Customer, never User.
// Staff accounts and guests are different populations with different powers,
// and a shared table would be one bug away from a guest holding a staff role.
model GuestLoginToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

model Booking {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  // What the guest is told to quote. Short and unambiguous out loud, which a
  // cuid is not.
  reference  String   @unique
  checkIn    DateTime @db.Date
  checkOut   DateTime @db.Date
  adults     Int
  children   Int
  infants    Int
  pets       Int      @default(0)

  status     BookingStatus @default(PENDING)
  totalPrice Decimal       @db.Decimal(10, 2)

  /// Where the booking came from. A stay taken over the phone never appears in
  /// Stripe's ledger, so without this the payments panel looks like it is
  /// missing money that was in fact received in cash.
  source        BookingSource @default(WEBSITE)
  /// How it was collected when Stripe was not involved: CASH, TRANSFER, CARD,
  /// OTHER. Null on anything Stripe handled — that has a PaymentIntent instead.
  paymentMethod String?

  // The bill as it was charged, frozen at the moment of booking.
  //
  // Recomputing it later would show today's prices on a stay bought last
  // season: a receipt has to say what was paid, not what the same nights
  // would cost now. Every figure here is the server's, never the browser's.
  nightsSubtotal     Decimal @default(0) @db.Decimal(10, 2)
  weeklyDiscount     Decimal @default(0) @db.Decimal(10, 2)
  extrasTotal        Decimal @default(0) @db.Decimal(10, 2)
  additionalGuestFee Decimal @default(0) @db.Decimal(10, 2)
  cleaningFee        Decimal @default(0) @db.Decimal(10, 2)
  serviceFee         Decimal @default(0) @db.Decimal(10, 2)
  taxes              Decimal @default(0) @db.Decimal(10, 2)

  // Where to finish paying, while the hold is alive. Cleared on confirmation:
  // a Stripe session that already paid is not a link to hand anyone.
  checkoutUrl String?
  // When a PENDING hold stops holding the dates. Null once paid: a confirmed
  // stay never expires. The date range is guarded by an exclusion constraint
  // (see the migration), so two guests cannot pay for the same week.
  expiresAt   DateTime?

  stripeSessionId       String?   @unique
  // Stripe refunds a PaymentIntent, not a Checkout Session. Kept at
  // confirmation so a refund does not depend on Stripe still answering about
  // a session from last season.
  stripePaymentIntentId String?   @unique
  paidAt                DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  specialRequests String?
  // The language the guest booked in, so their confirmation arrives in it.
  // The host's alerts are always in Spanish; these are not.
  locale          String   @default("es")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  extras  BookingExtra[]
  refunds Refund[]

  @@index([propertyId, checkIn, checkOut])
  @@index([status, expiresAt])
}

enum ExtraPricingType {
  PER_NIGHT
  PER_HOUR
  PER_STAY
}

model Extra {
  id                  String           @id @default(cuid())
  propertyId          String
  property            Property         @relation(fields: [propertyId], references: [id])
  key                 String
  name                String
  pricingType         ExtraPricingType
  price               Decimal          @db.Decimal(10, 2)
  refundable          Boolean          @default(true)
  seasonStartMonthDay String? // "MM-DD", e.g. heated pool season start
  seasonEndMonthDay   String?
  requiresRequest     Boolean          @default(false)
  active              Boolean          @default(true)

  bookingExtras BookingExtra[]

  @@unique([propertyId, key])
}

model BookingExtra {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraId   String
  extra     Extra   @relation(fields: [extraId], references: [id])
  quantity  Int     @default(1)

  @@unique([bookingId, extraId])
}

// Airbnb's ladder, because it is the vocabulary guests already know. The host
// picks one; the site states it in their language and prints it on the PDF.
enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  FIRM
  STRICT
}

enum SeasonType {
  LOW
  HIGH
  WEEKEND
}

/// One line per movement of money back out, never overwritten.
///
/// A `refundedTotal` column on Booking would answer "how much" and nothing
/// else. Fase 7.5 has to exclude refunds from the taxable base and say when
/// they happened, the panel has to show who authorised each one, and a stay
/// can be refunded twice — a partial now and the rest after a conversation.
/// None of that fits in a running total.
model Refund {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount         Decimal @db.Decimal(10, 2)
  /// What the ladder proposed, kept even when the host overrode it: the gap
  /// between the two is the only record that a judgement call was made.
  proposedAmount Decimal @db.Decimal(10, 2)
  /// Which rung decided the proposal (FULL, HALF, NONE, GRACE, STAY_STARTED).
  reason         String
  note           String?

  /// Null while Stripe has not answered yet, and for money returned by other
  /// means — a transfer the host made by hand still belongs in the ledger.
  stripeRefundId String?      @unique
  status         RefundStatus @default(PENDING)
  failureReason  String?

  /// How the money actually goes back, which decides how long it takes.
  /// `reversal` means the original charge had not settled yet and it unwinds
  /// in days; `refund` means it had, and the guest's bank takes its usual
  /// 5-10 business days. Stripe knows which; nobody else does.
  settlesAs     String?
  /// The acquirer reference number. The only thing a guest whose bank says
  /// "we see nothing" can actually hand over. Often null at first: Stripe
  /// fills it in later, which is what charge.refund.updated is for.
  cardReference String?

  /// Who authorised it. Not a relation with a cascade: deleting a user must
  /// not erase the record of a refund they approved.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId])
  @@index([createdAt])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One authority the host owes tax to, at one rate, for one stretch of time.
///
/// `Property.taxesPercent` is a single 13 % and stays the one figure a guest is
/// charged. It cannot be what gets declared: Florida DOR and the Pinellas Tax
/// Collector are remitted **separately**, on different calendars, and a return
/// asks for their share, not a total.
///
/// Dated on purpose. A rate change must not rewrite what was already collected,
/// so a new rate is a new row with its own `effectiveFrom`, and the old one is
/// closed rather than edited.
model TaxJurisdiction {
  id        String  @id @default(cuid())
  /// What the host calls it: "Estatal de Florida", "Condado de Pinellas".
  name      String
  /// Who the money is remitted to. Printed on the report the accountant gets.
  authority String
  percent   Decimal @db.Decimal(5, 2)

  effectiveFrom DateTime  @db.Date
  /// Null while this is the rate in force. Set when a new one supersedes it.
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filings TaxFiling[]

  @@index([effectiveFrom])
}

/// A period declared and paid to one authority.
///
/// The report can always be recomputed from the bookings; what it cannot know
/// is whether anyone actually filed it. That is the only thing stored here,
/// which is also why it is a row rather than a flag: the reference of the
/// payment and the date it went out are what an audit asks for.
model TaxFiling {
  id             String          @id @default(cuid())
  jurisdictionId String
  jurisdiction   TaxJurisdiction @relation(fields: [jurisdictionId], references: [id])

  /// First and last day of the period, inclusive. Monthly or quarterly, as the
  /// authority requires — stored as dates so neither is assumed.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  /// What was declared. Frozen: recomputing it later could disagree with what
  /// was actually remitted, and the remittance is the fact.
  amount    Decimal  @db.Decimal(10, 2)
  filedAt   DateTime
  /// Confirmation number from the authority, or the bank reference.
  reference String?
  notes     String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([jurisdictionId, periodStart, periodEnd])
  @@index([periodStart])
}

model PriceRule {
  id          String     @id @default(cuid())
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id])
  name        String
  type        SeasonType
  startDate   DateTime?  @db.Date // null for the recurring WEEKEND rule
  endDate     DateTime?  @db.Date
  nightlyRate Decimal    @db.Decimal(10, 2)
  /// How many nights a stay *starting* in this season must be. Null leaves the
  /// house-wide `Property.minNights` in charge. A season can only ask for more
  /// nights, never fewer.
  minNights   Int?
  active      Boolean    @default(true)
}

model BlockedDate {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?

  @@index([propertyId, startDate, endDate])
}

// Fase 4 (auth). Staff accounts for /admin — distinct from Customer, which is
// a booking guest and never signs in. Roles are a fixed enum rather than
// Role/Permission tables: docs/domain-decisions.md pins them to these three.
enum UserRole {
  SUPERADMIN
  MANAGER
  VIEWER
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? // set by the brute-force lockout, cleared on success
  lastLoginAt         DateTime?
  // TOTP second factor. The secret is encrypted at rest (AES-256-GCM, key from
  // TOTP_ENCRYPTION_KEY) because unlike a password hash it must be recoverable
  // to verify codes — storing it in plaintext would make a DB leak enough to
  // mint valid codes. totpEnabledAt is null until the user confirms setup.
  totpSecret          String?
  totpEnabledAt       DateTime?
  // Invitation state. passwordHash is filled with an unguessable random value
  // when someone is invited, so the account exists but cannot be signed into
  // until they follow the emailed link. passwordSetAt is what distinguishes
  // "invited, never signed in" from "active" — keeping passwordHash non-null
  // avoids null-guarding argon2.verify in four call sites.
  invitedAt           DateTime?
  passwordSetAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  recoveryCodes       RecoveryCode[]
  passwordResetTokens PasswordResetToken[]
}

// Refresh tokens are opaque (not JWTs) and stored hashed, so a database leak
// can't be replayed. Rotated on every use: the previous row is revoked.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use fallback codes so losing the authenticator device doesn't mean
// losing the account. Hashed, like refresh tokens — the plaintext is shown to
// the user exactly once, at setup.
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String    @unique
  usedAt   DateTime?

  @@index([userId])
}

// Emailed password-reset links. Hashed and single-use like the tokens above,
// and short-lived: the link travels through email, which we don't control.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Fase 5 (CMS). Everything a host can edit without a developer.
//
// Content is stored **once**, in the language it was written in (DEFAULT_LOCALE).
// Every other language lives in Translation below.
//
// It used to be two columns per field (…Es/…En). That worked for two languages
// and fell apart at five: the host would have written every sentence five
// times, and ContentSection alone would have carried forty columns. The host
// now writes once and the site serves whichever language the visitor picked.
// ---------------------------------------------------------------------------

enum CMSPageSlug {
  ABOUT_SPACE
  ACCOMMODATION
  LIVING_AREAS
  KITCHEN_DINING
  BEDROOMS_BATHROOMS
  OUTDOOR_LIFE
  AMENITIES
  LOCATION
  GUEST_ACCESS
  HOUSE_RULES
  FAQS
  POLICIES
}

model CMSPage {
  id        String      @id @default(cuid())
  slug      CMSPageSlug @unique
  title     String
  body      String
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum FAQCategory {
  PETS
  TRASH
  POOL
  PARTIES
  GENERAL
}

model FAQ {
  id        String      @id @default(cuid())
  question  String
  answer    String
  category  FAQCategory @default(GENERAL)
  sortOrder Int         @default(0)
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([category, sortOrder])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Single row, like Property. `id` is pinned to a constant so upserts can find
// it without a lookup, and so a second row can't be created by accident.
/**
 * Which company carries the WhatsApp message.
 * Both end at the same place. Twilio sends today at the cost of a markup and a
 * shared sender; Meta is the official path with your own number and no markup,
 * but needs a Business account and a verified number.
 * Neither escapes Meta's 24-hour rule — that belongs to WhatsApp, not to the
 * reseller.
 */
enum WhatsAppProvider {
  TWILIO
  META
}

model SiteSettings {
  id           String @id @default("site")
  // Shown to guests, in the footer and the contact card.
  contactEmail String
  contactPhone String
  whatsapp     String

  // Where the host is told about a booking, a cancellation or a message.
  // Separate from the public ones on purpose: the address a guest writes to is
  // rarely the one the host wants woken up at.  Empty falls back to the public
  // field, so a host who only has one address does not have to type it twice.
  notifyEmail      String           @default("")
  notifyWhatsapp   String           @default("")
  // A Telegram chat id, not a phone number: it comes from `getUpdates` after the
  // host writes to the bot once, which is also what authorises the bot to reply.
  // No public fallback exists because a chat id is never given to a guest.
  notifyTelegram   String           @default("")
  // Which provider carries the WhatsApp alerts. Only one is used at a time:
  // sending the same message twice is noise, not redundancy.
  whatsappProvider WhatsAppProvider @default(TWILIO)
  notifyOnBooking  Boolean          @default(true)
  notifyOnCancel   Boolean          @default(true)
  // Changes to a stay that is already sold: dates moved, guest count edited.
  notifyOnChange   Boolean          @default(true)
  notifyOnMessage  Boolean          @default(true)
  seoTitle         String
  seoDescription   String
  instagramUrl     String?
  facebookUrl      String?
  airbnbUrl        String?
  // Header and footer share one mark; null falls back to the bundled PNG.
  logoUrl          String?
  // The same mark drawn for a dark page. The light one is black ink on
  // transparency, so on the dark header the wordmark disappears and only the
  // turquoise starfish survives. Null falls back to the bundled white version.
  logoDarkUrl      String?
  // The tab icon. Null falls back to the bundled starfish, which ships in a
  // light and a dark variant; one uploaded file replaces both.
  faviconUrl       String?
  updatedAt        DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Landing page content.
//
// CMSPage above holds the long prose a guest reads. These three hold the
// landing page itself: its section headings, the repeated card/badge/stat
// lists, and the testimonials.
//
// Two models instead of one per section: the page has five different lists
// (hero badges, feature cards, amenities, nearby highlights, host stats) that
// are all "icon + optional image + a bilingual label and body, in an order".
// One ContentItem covers all five, so they also share one editor. Review is
// separate because it genuinely has a different shape — a rating, an author
// and a photo.
// ---------------------------------------------------------------------------

enum ContentSectionKey {
  HERO
  FEATURES
  AMENITIES
  REVIEWS
  LOCATION
  DIRECT_BOOKING
  HOST
  FOOTER
}

model ContentSection {
  id  String            @id @default(cuid())
  key ContentSectionKey @unique

  // Not every section uses every slot — an empty string means "don't render".
  // Nullable columns would say the same thing with more null checks.
  eyebrow  String @default("")
  title    String @default("")
  subtitle String @default("")
  body     String @default("")
  ctaLabel String @default("")
  ctaHref  String @default("")

  // The one headline figure a section can carry: the review score, the host's
  // years hosting. Kept as text because "5.0" and "< 1 hour" are both valid.
  statValue String @default("")
  statLabel String @default("")

  imageUrl String? // host portrait, section background
  linkUrl  String? // map embed for LOCATION

  // REVIEWS unpublished hides the whole block, which is what the host asked
  // for: a section with nothing worth showing shouldn't render an empty frame.
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ContentItem[]
}

enum ContentItemKind {
  HERO_BADGE
  FEATURE_CARD
  AMENITY
  LOCATION_HIGHLIGHT
  HOST_STAT
  REVIEW_RATING
}

model ContentItem {
  id        String          @id @default(cuid())
  sectionId String
  section   ContentSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  kind      ContentItemKind

  icon     String  @default("") // lucide-react name, picked from a curated list
  imageUrl String?
  label    String
  body     String  @default("")
  // Host stats ("10+", "100%") and review sub-scores ("4.9").
  value    String  @default("")

  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, kind, sortOrder])
}

// Guest testimonials shown on the landing page. Editorial content, not part of
// the booking domain: it has no relation to Booking or Customer, and deleting
// one changes the page, never a reservation.
model Review {
  id             String  @id @default(cuid())
  authorName     String
  authorPhotoUrl String?
  rating         Int     @default(5)
  text           String
  // Free text ("noviembre de 2025"): the source listing gives no exact dates,
  // and inventing them would be inventing data.
  stayedAt       String  @default("")
  verified       Boolean @default(true)
  // The one pulled out into the large quote block at the top.
  featured       Boolean @default(false)

  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ---------------------------------------------------------------------------
// Translations.
//
// One row per (record, field, language). The source text itself is not here —
// it stays on its own model, in DEFAULT_LOCALE — so a missing row simply means
// "not translated yet" and the site falls back to the source. A guest reading
// Spanish on a French page is better than a guest reading a blank one.
//
// `entity` and `entityId` are a loose reference on purpose: a real foreign key
// would need one join table per model, and this table has no meaning of its
// own to protect. Rows are cleaned up with the record that owns them.
// ---------------------------------------------------------------------------

model Translation {
  id       String @id @default(cuid())
  entity   String // "ContentSection", "Review", …
  entityId String
  field    String // "title", "body", …
  locale   String // never DEFAULT_LOCALE: that text lives on the record
  text     String

  /**
   * SHA-256 of the source text this was translated from.
   * Without it, editing the Spanish would silently leave four stale
   * translations that still look fine. The resolver compares this against the
   * current source and treats a mismatch as untranslated.
   */
  sourceHash String

  /**
   * False once a human has edited it, so re-translation stops overwriting.
   */
  isMachine Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, entityId, field, locale])
  @@index([entity, entityId, locale])
}
