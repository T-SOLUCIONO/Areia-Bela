DATABASE_URL="postgresql://areia_bela:areia_bela_dev@localhost:5432/areia_bela?schema=public"
PORT=3001

# Auth (Fase 4). See docs/env.md — names and purpose only, never real values.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_at_least_32_characters_long
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=change_me_64_hex_chars_or_32plus_char_passphrase
CORS_ORIGINS=http://localhost:3000
# Only needed when running the seed; the seed fails loudly if unset.
ADMIN_SEED_PASSWORD=

# Email (Brevo transactional API). Without BREVO_API_KEY nothing is sent — the
# reset link is logged instead, which is fine for local dev only.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@areiabela.com
EMAIL_FROM_NAME=Areia Bela
# Base URL used to build links inside emails.
WEB_APP_URL=http://localhost:3000
