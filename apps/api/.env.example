DATABASE_URL="postgresql://areia_bela:areia_bela_dev@localhost:5432/areia_bela?schema=public"
PORT=3001

# Auth (Fase 4). See docs/env.md — names and purpose only, never real values.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_at_least_32_characters_long
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=change_me_64_hex_chars_or_32plus_char_passphrase
CORS_ORIGINS=http://localhost:3000
# Only needed when running the seed; the seed fails loudly if unset.
ADMIN_SEED_PASSWORD=

# Email (Brevo transactional API). Without BREVO_API_KEY nothing is sent — the
# reset link is logged instead, which is fine for local dev only.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@areiabela.com
EMAIL_FROM_NAME=Areia Bela
# Base URL used to build links inside emails.
WEB_APP_URL=http://localhost:3000

# Vercel Blob, for gallery uploads. Without it images are written to
# apps/web/public/uploads/ (development only — see docs/env.md).
BLOB_READ_WRITE_TOKEN=

# Translation. The site content is written once in Spanish and translated into
# the other four languages on save. Pick one provider; without any of them the
# site shows Spanish everywhere and the admin says so. See docs/env.md.
#
# DeepL is the recommended one: free, 500,000 characters a month. Free-tier keys
# end in ":fx" and the code routes them to the right host automatically.
DEEPL_API_KEY=
# Optional: force a provider (deepl | libretranslate | claude). Otherwise the
# first one configured wins, DeepL first.
TRANSLATION_PROVIDER=
# Self-hosted alternative, so the copy never leaves your server:
#   docker run -p 5000:5000 libretranslate/libretranslate
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Paid, but the only one that can be told this is a house and not a hotel.
ANTHROPIC_API_KEY=

# WhatsApp alerts for bookings, cancellations and messages. Optional: without
# these, everything still reaches the host by email. See docs/env.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Stripe. Both live here: the API prices the stay, opens the payment and
# verifies the webhook, so the frontend holds no Stripe credentials at all.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Base URL of the guest site. Used to build the links that go out by email —
# the guest sign-in link, above all. See docs/env.md.
PUBLIC_SITE_URL=http://localhost:3000
