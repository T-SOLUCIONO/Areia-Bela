    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.18.0",
    "jest": "^30.4.2",
    "prisma": "^6.10.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
