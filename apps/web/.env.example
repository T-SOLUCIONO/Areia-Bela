# Base URL of the NestJS API (apps/api). Used by the public booking calendar
# to load blocked dates. If unset, the calendar still works — it just won't
# exclude unavailable dates.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stripe test keys — get your own from https://dashboard.stripe.com/test/apikeys
# Never commit real values; apps/web/.env is gitignored.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
