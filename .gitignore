apps/web/public/uploads/

# Generated by Next on every dev/build, and it writes a different import path
# for each ("/.next/types" vs "/.next/dev/types"). The file itself says it
# should not be edited, yet Prettier reformatted it on commit — between the two
# it produced a permanent diff that broke lint-staged. `tsc --noEmit` passes
# without it, and `next build` recreates it.
apps/web/next-env.d.ts
